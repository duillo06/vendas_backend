# Copie para .env.production e preencha os valores reais.
# NUNCA commite .env.production com secrets.

DJANGO_ENV=production
SECRET_KEY=troque-por-uma-chave-segura-aleatoria
DEBUG=False

# Domínio raiz (sem https://) — usado no remote-deploy + Caddy/Nginx
BASE_DOMAIN=foodservice.app

# Hosts separados por vírgula
ALLOWED_HOSTS=.foodservice.app,api.foodservice.app,admin.foodservice.app,demo.foodservice.app

POSTGRES_DB=foodservice
POSTGRES_USER=foodservice
POSTGRES_PASSWORD=troque-a-senha-do-banco
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS — origens explícitas (regex no settings cobre subdomínios de tenant)
CORS_ALLOWED_ORIGINS=https://admin.foodservice.app,https://api.foodservice.app,https://demo.foodservice.app

# CSRF (admin SPA na mesma origem ou origins HTTPS)
CSRF_TRUSTED_ORIGINS=https://admin.foodservice.app,https://api.foodservice.app

STOREFRONT_BASE_DOMAIN=foodservice.app
APP_VERSION=1.0.0

# Build do frontend — relativa = mesma origem (sem CORS no storefront)
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_TENANT_SUBDOMAIN=demo
# VITE_STOREFRONT_BASE_DOMAIN vem de BASE_DOMAIN no compose

# E-mail (confirmação de pedido via Celery)
DEFAULT_FROM_EMAIL=noreply@foodservice.app
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=sua-api-key-sendgrid
EMAIL_USE_TLS=true

# Opcional — monitoramento de erros
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# TLS termina no Caddy — Django NÃO deve redirecionar (evita 301 em loop)
SECURE_SSL_REDIRECT=false
HTTP_PORT=80
HTTPS_PORT=443

# —— Evolution compartilhada (repo separado: github.com/duillo06/evolution) ——
# Stack em /opt/evolution — porta só localhost:8080
EVOLUTION_HOSTED_BASE_URL=http://host.docker.internal:8080
EVOLUTION_HOSTED_API_KEY=mesma-AUTHENTICATION_API_KEY-da-evolution
# URL pública desta API (webhooks Evolution → Food Service)
PUBLIC_API_BASE_URL=https://api.foodservice.app
