# Template Nginx — __BASE_DOMAIN__ é trocado pelo remote-deploy.sh
# Caddy termina TLS e manda X-Forwarded-Proto; não use $scheme (seria http interno).
upstream api_backend {
    server api:8000;
}

# Backoffice — admin.__BASE_DOMAIN__
server {
    listen 80;
    server_name admin.__BASE_DOMAIN__;

    root /usr/share/nginx/admin;
    index index.html;

    location /api/ {
        proxy_pass http://api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 10M;
    }

    location /media/ {
        alias /var/www/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API dedicada — api.__BASE_DOMAIN__
server {
    listen 80;
    server_name api.__BASE_DOMAIN__;

    client_max_body_size 10M;

    location /media/ {
        alias /var/www/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

# Storefront por tenant — {tenant}.__BASE_DOMAIN__
server {
    listen 80;
    server_name ~^(?<tenant>[\w-]+)\.__BASE_DOMAIN_ESCAPED__$;

    root /usr/share/nginx/storefront;
    index index.html;

    location /api/ {
        proxy_pass http://api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 10M;
    }

    location /media/ {
        alias /var/www/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
